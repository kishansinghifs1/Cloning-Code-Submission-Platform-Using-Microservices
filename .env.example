# Copy this file to .env and fill with real values before running docker compose

# Shared DB URLs
ATLAS_DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
LOG_DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# User-Service JWT secrets
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
